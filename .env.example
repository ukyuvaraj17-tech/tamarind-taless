# Supabase Config — get these from Supabase Dashboard > Project Settings > API
REACT_APP_SUPABASE_URL=https://your-project.supabase.co
REACT_APP_SUPABASE_ANON_KEY=your-anon-key

# Cloudinary — for image uploads (get from cloudinary.com)
REACT_APP_CLOUDINARY_CLOUD_NAME=your_cloud_name
REACT_APP_CLOUDINARY_UPLOAD_PRESET=your_upload_preset

# Admin email — only this email can access /admin
REACT_APP_ADMIN_EMAIL=pc1@uktex.net

# Payment redirect URL — your payment page link (Razorpay payment link)
REACT_APP_PAYMENT_URL=https://rzp.io/l/your-payment-link
